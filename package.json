{
  "name": "lagan",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --cwd apps/web dev",
    "build": "bun --cwd apps/web build",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "gen:tokens": "bun scripts/gen-tokens.ts",
    "check:contrast": "bun scripts/check-contrast.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:demo": "bun scripts/seed-demo.ts",
    "seed:demo:clean": "bun scripts/seed-demo.ts --clean",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/pg": "8.23.1",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "typescript": "^5.8.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "better-auth": "1.7.11",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  }
}
