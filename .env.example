# Copy to .env (root, for Bun scripts) or apps/web/.env.local (for Next.js).
# Both files are git-ignored; this example is not.

DATABASE_URL=postgres://lagan:lagan@localhost:5432/lagan

# Mux Video. Token id and secret come from https://dashboard.mux.com/settings/access-tokens.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Signing secret of the webhook pointed at /api/mux/webhook
# (https://dashboard.mux.com/settings/webhooks). Each endpoint has its own.
MUX_WEBHOOK_SIGNING_SECRET=

# Stripe secret key, from https://dashboard.stripe.com/apikeys.
STRIPE_SECRET_KEY=

# Signing secret of the webhook pointed at /api/stripe/webhook
# (https://dashboard.stripe.com/webhooks). Each endpoint has its own.
STRIPE_WEBHOOK_SIGNING_SECRET=

# Absolute origin used for Checkout success and cancel redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
